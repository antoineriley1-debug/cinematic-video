# Database (SQLite for development; use PostgreSQL in production — see docs/DEPLOYMENT.md)
DATABASE_URL="file:./dev.db"

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-64-char-hex-secret"

# AI providers (server-side only — NEVER exposed to the browser).
# Any subset works; the orchestrator routes and fails over across whichever
# are configured (order: admin setting ai.primaryProvider, then the rest).
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides
ANTHROPIC_MODEL="claude-sonnet-5"
GEMINI_MODEL="gemini-flash-latest"
OPENAI_MODEL="gpt-4o"

# Object storage root (local filesystem adapter by default; S3-compatible adapter configurable)
STORAGE_DIR="./storage"

# Email intake (Method B): POST raw RFC-822 to /api/intake/email with header
# x-intake-token: $EMAIL_INTAKE_TOKEN (generate: openssl rand -hex 24).
# Endpoint stays disabled until the token is set.
EMAIL_INTAKE_ADDRESS=""
EMAIL_INTAKE_TOKEN=""
EMAIL_INTAKE_DEFAULT_OWNER=""

# SMTP delivery for optional email copies of mentions/attention/alerts
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Crothall Executive OS <no-reply@example.com>"
APP_BASE_URL=""

# Voice provider (server-side; supported: elevenlabs)
VOICE_PROVIDER=""
VOICE_API_KEY=""
VOICE_ID=""
VOICE_MODEL=""

# Plaud — DEFERRED (audio drag-and-drop + transcript import cover the
# workflow). Future integration per docs.plaud.ai: Transcription API using
# client_id + client_secret from portal.plaud.ai against
# https://platform-us.plaud.ai/developer/api (see services/plaudSync.ts).
# PLAUD_CLIENT_ID=""
# PLAUD_CLIENT_SECRET=""
